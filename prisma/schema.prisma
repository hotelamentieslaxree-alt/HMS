// ARIA HMS — Hospitality Operating System
// Prisma schema (SQLite). Note: SQLite has no native ENUM / array / JSONB,
// so enums are stored as String with app-level validation, and arrays/objects
// are stored as JSON strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════
// PROPERTY & ORG
// ════════════════════════════════════════════════════════════════

model Property {
  id            String   @id @default(cuid())
  name          String
  code          String
  city          String
  state         String?
  country       String
  timezone      String   @default("Asia/Calcutta")
  currency      String   @default("INR")
  starRating    Int      @default(5)
  totalRooms    Int      @default(0)
  checkInTime   String   @default("14:00")
  checkOutTime  String   @default("12:00")
  gstNumber     String?
  taxId         String?
  logoUrl       String?
  status        String   @default("active") // active | suspended
  businessDate  DateTime @default(now())    // current business date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roomCategories    RoomCategory[]
  rooms             Room[]
  reservations      Reservation[]
  housekeepingTasks HousekeepingTask[]
  outlets           Outlet[]
  ratePlans         RatePlan[]
  auditLogs         AuditLog[]
  users             User[]
  departments       Department[]
  shiftHandovers    ShiftHandover[]
  attendance        Attendance[]
  payrollRecords    PayrollRecord[]
  companyEvents     CompanyEvent[]
  scorecards        Scorecard[]
  leads             Lead[]
  deals             Deal[]
  campaigns         Campaign[]
  socialAccounts    SocialAccount[]
  // Enterprise v2 relations
  moduleConfigs     ModuleConfig[]
  patients          Patient[]
  doctors           Doctor[]
  appointments      Appointment[]
  stockItems        StockItem[]
  vendors           Vendor[]
  purchaseOrders    PurchaseOrder[]
  invoices          Invoice[]
  expenses          Expense[]
  cashbookEntries   CashbookEntry[]
  tasks             Task[]
  documents         Document[]
  integrationConfigs IntegrationConfig[]
}

model Department {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  code       String // FO | HK | FB | ENG | HR | FIN | SEC | SALES | MKT
  headUserId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  users    User[]

  @@index([propertyId])
}

model User {
  id            String   @id @default(cuid())
  propertyId    String?
  email         String   @unique
  firstName     String
  lastName      String
  role          String   // owner | gm | fom | hk_mgr | fb_mgr | rev_mgr | fin_mgr | eng_mgr | hr_mgr | receptionist | hk_attendant | waiter | technician
  roleLevel     Int      @default(4) // 1 owner, 2 gm, 3 manager, 4 staff
  departmentId  String?
  employeeCode  String?
  phone         String?
  isActive      Boolean  @default(true)
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property    Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  hkTasks     HousekeepingTask[] @relation("HkTaskAssignee")
  hkInspected HousekeepingTask[] @relation("HkTaskInspector")
  posOrders     PosOrder[]       @relation("PosOrderWaiter")
  auditLogs     AuditLog[]
  attendance    Attendance[]
  payrollRecords PayrollRecord[]
  scorecards    Scorecard[]
  organizedEvents CompanyEvent[]  @relation("EventOrganizer")
  assignedLeads   Lead[]          @relation("LeadAssignee")
  assignedDeals   Deal[]          @relation("DealAssignee")
  // Enterprise v2 relations
  sessions        Session[]
  loginHistory    LoginHistory[]
  userPermissions UserPermission[]
  assignedTasks   Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskAssigner")
  uploadedDocs    Document[]       @relation("DocumentUploader")

  @@index([propertyId])
}

// ════════════════════════════════════════════════════════════════
// ROOMS & RATES
// ════════════════════════════════════════════════════════════════

model RoomCategory {
  id                  String   @id @default(cuid())
  propertyId          String
  name                String
  code                String
  description         String?
  maxAdults           Int      @default(2)
  maxChildren         Int      @default(1)
  baseRate            Float
  amenities           String   @default("[]") // JSON array
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms        Room[]
  ratePlans    RatePlan[]   @relation("RatePlanCategories")
  reservations Reservation[]

  @@index([propertyId])
}

model Room {
  id            String   @id @default(cuid())
  propertyId    String
  categoryId    String
  roomNumber    String
  floor         Int
  wing          String?
  currentStatus String   @default("vacant_clean")
  // vacant_clean | vacant_dirty | occupied_clean | occupied_dirty | out_of_order | out_of_service
  isSmoking     Boolean  @default(false)
  isAccessible  Boolean  @default(false)
  notes         String?
  blockedReason String?
  blockedUntil  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category         RoomCategory      @relation(fields: [categoryId], references: [id])
  statusLogs       RoomStatusLog[]
  hkTasks          HousekeepingTask[]
  reservationRooms Reservation[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId, currentStatus])
}

model RoomStatusLog {
  id         String   @id @default(cuid())
  roomId     String
  oldStatus  String?
  newStatus  String
  changedBy  String?
  reason     String?
  changedAt  DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model RatePlan {
  id                 String   @id @default(cuid())
  propertyId         String
  name               String
  code               String
  description        String?
  mealPlan           String   @default("ep") // ep | cp | map | ap
  isRefundable       Boolean  @default(true)
  advancePurchaseDays Int     @default(0)
  minStayNights      Int      @default(1)
  maxStayNights      Int      @default(30)
  validFrom          DateTime
  validTo            DateTime
  markupPercent      Float    @default(0) // over base rate
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  categories  RoomCategory[] @relation("RatePlanCategories")
  reservations Reservation[]

  @@index([propertyId])
}

// ════════════════════════════════════════════════════════════════
// GUESTS & RESERVATIONS
// ════════════════════════════════════════════════════════════════

model Guest {
  id              String   @id @default(cuid())
  title           String   @default("Mr")
  firstName       String
  lastName        String
  email           String?
  phone           String?
  nationality     String   @default("IN")
  idType          String?  // passport | aadhaar | driving_license | voter
  idNumber        String?
  dateOfBirth     DateTime?
  address         String?
  city            String?
  state           String?
  country         String   @default("IN")
  loyaltyTier     String   @default("silver") // none | silver | gold | platinum
  loyaltyPoints   Int      @default(0)
  preferences     String   @default("{}") // JSON
  vipStatus       Boolean  @default(false)
  doNotDisturb    Boolean  @default(false)
  totalStays      Int      @default(0)
  totalRevenue    Float    @default(0)
  blacklisted     Boolean  @default(false)
  blacklistReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  primaryReservations Reservation[] @relation("PrimaryGuestReservations")

  @@index([email])
  @@index([phone])
}

model Company {
  id            String   @id @default(cuid())
  name          String
  gstNumber     String?
  address       String?
  creditLimit   Float    @default(0)
  paymentTerms  String?
  contactName   String?
  contactEmail  String?
  negotiatedRate Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservations Reservation[]
}

model Reservation {
  id              String   @id @default(cuid())
  propertyId      String
  confirmationNumber String @unique
  bookingSource   String   @default("direct") // direct | booking_com | expedia | airbnb | makemytrip | goibibo | agoda | corporate | walk_in | phone
  status          String   @default("confirmed") // confirmed | tentative | waitlisted | checked_in | checked_out | cancelled | no_show
  primaryGuestId  String
  companyId       String?
  categoryId      String
  roomId          String?
  ratePlanId      String?
  ratePerNight    Float
  totalNights     Int
  checkInDate     DateTime
  checkOutDate    DateTime
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  adults          Int      @default(2)
  children        Int      @default(0)
  infants         Int      @default(0)
  specialRequests String?
  internalNotes   String?
  otaCommissionPercent Float @default(0)
  otaCommissionAmount   Float @default(0)
  netRevenue      Float    @default(0)
  depositAmount   Float    @default(0)
  cancellationReason String?
  cancelledAt     DateTime?
  cancelledBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  primaryGuest Guest        @relation("PrimaryGuestReservations", fields: [primaryGuestId], references: [id])
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  category     RoomCategory @relation(fields: [categoryId], references: [id])
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  ratePlan     RatePlan?    @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  folios       Folio[]

  @@index([propertyId, status])
  @@index([propertyId, checkInDate])
  @@index([primaryGuestId])
}

// ════════════════════════════════════════════════════════════════
// FOLIO & BILLING
// ════════════════════════════════════════════════════════════════

model Folio {
  id           String   @id @default(cuid())
  reservationId String
  folioNumber  String   @unique
  folioType    String   @default("room") // room | extra | advance | city_ledger
  status       String   @default("open") // open | closed | transferred
  subtotal     Float    @default(0)
  taxAmount    Float    @default(0)
  totalAmount  Float    @default(0)
  paidAmount   Float    @default(0)
  balance      Float    @default(0)
  createdAt    DateTime @default(now())
  closedAt     DateTime?
  closedBy     String?

  reservation Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  lines       FolioLine[]
  payments    Payment[]

  @@index([reservationId])
}

model FolioLine {
  id              String   @id @default(cuid())
  folioId         String
  transactionType String   @default("charge") // charge | payment | adjustment | void
  description     String
  amount          Float    @default(0)
  taxCode         String?
  taxAmount       Float    @default(0)
  departmentCode  String?  // ROOM | FB | MINIBAR | LAUNDRY | SPA | MISC
  outletCode      String?
  postedAt        DateTime @default(now())
  postedBy        String?
  referenceType   String?  // pos_order | minibar | room_rate | manual
  referenceId     String?
  isVoided        Boolean  @default(false)
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
}

model Payment {
  id            String   @id @default(cuid())
  folioId       String
  amount        Float
  paymentMethod String   // cash | credit_card | debit_card | upi | bank_transfer | city_ledger
  paymentReference String?
  cardLast4     String?
  cardType      String?
  status        String   @default("completed") // pending | completed | failed | refunded
  processedAt   DateTime @default(now())
  processedBy   String?

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
}

// ════════════════════════════════════════════════════════════════
// HOUSEKEEPING
// ════════════════════════════════════════════════════════════════

model HousekeepingTask {
  id            String   @id @default(cuid())
  propertyId    String
  roomId        String
  taskType      String   @default("checkout_cleaning") // checkout_cleaning | stayover | turndown | deep_clean | inspection | maintenance_prep
  assignedToId  String?
  priority      String   @default("normal") // urgent | high | normal | low
  status        String   @default("pending") // pending | in_progress | completed | inspected | rejected
  scheduledFor  DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  inspectedById String?
  inspectedAt   DateTime?
  rejectionReason String?
  checklist     String   @default("[]") // JSON array of {item, done}
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee    User?    @relation("HkTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  inspector   User?    @relation("HkTaskInspector", fields: [inspectedById], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([assignedToId])
}

model LostFound {
  id              String   @id @default(cuid())
  propertyId      String
  itemDescription String
  itemCategory    String?
  foundLocation   String?
  foundDate       DateTime @default(now())
  foundBy         String?
  storageLocation String?
  status          String   @default("in_custody") // in_custody | claimed | disposed | donated
  claimedBy       String?
  claimedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId, status])
}

// ════════════════════════════════════════════════════════════════
// F&B / POS
// ════════════════════════════════════════════════════════════════

model Outlet {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  code       String
  type       String   @default("restaurant") // restaurant | bar | cafe | room_service | banquet | pool_bar
  isActive   Boolean  @default(true)
  tableCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tables     RestaurantTable[]
  menuCategories MenuCategory[]
  orders     PosOrder[]

  @@index([propertyId])
}

model RestaurantTable {
  id         String   @id @default(cuid())
  outletId   String
  tableNumber String
  capacity   Int      @default(4)
  status     String   @default("available") // available | occupied | reserved | cleaning
  section    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders PosOrder[]

  @@unique([outletId, tableNumber])
}

model MenuCategory {
  id         String   @id @default(cuid())
  outletId   String
  name       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  mealPeriod String   @default("[]") // JSON array
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([outletId])
}

model MenuItem {
  id            String   @id @default(cuid())
  categoryId    String
  name          String
  description   String?
  price         Float
  itemType      String   @default("food") // food | beverage | package
  dietType      String   @default("veg") // veg | non_veg | vegan | contains_egg | contains_alcohol
  allergens     String   @default("[]")
  preparationTimeMinutes Int @default(15)
  isAvailable   Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  photoUrl      String?
  recipeCost    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category   MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderLines PosOrderLine[]

  @@index([categoryId])
}

model PosOrder {
  id            String   @id @default(cuid())
  outletId      String
  tableId       String?
  reservationId String?
  orderType     String   @default("dine_in") // dine_in | room_service | takeaway | delivery | banquet
  status        String   @default("draft") // draft | sent_to_kitchen | in_preparation | ready | served | billed | paid | void
  waiterId      String?
  subtotal      Float    @default(0)
  discountAmount Float   @default(0)
  taxAmount     Float    @default(0)
  totalAmount   Float    @default(0)
  guestsCount   Int      @default(1)
  notes         String?
  kotNumber     Int?
  createdAt     DateTime @default(now())
  billedAt      DateTime?
  paidAt        DateTime?

  outlet Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table  RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiter User?            @relation("PosOrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  lines  PosOrderLine[]

  @@index([outletId, status])
}

model PosOrderLine {
  id                String   @id @default(cuid())
  orderId           String
  itemId            String
  quantity          Int      @default(1)
  unitPrice         Float
  specialInstructions String?
  status            String   @default("pending") // pending | in_progress | ready | served | void
  voidReason        String?
  createdAt         DateTime @default(now())

  order PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  MenuItem  @relation(fields: [itemId], references: [id])

  @@index([orderId])
}

// ════════════════════════════════════════════════════════════════
// MAINTENANCE
// ════════════════════════════════════════════════════════════════

model MaintenanceTicket {
  id          String   @id @default(cuid())
  propertyId  String
  roomId      String?
  title       String
  description String?
  priority    String   @default("normal") // urgent | high | normal | low
  status      String   @default("open") // open | in_progress | completed | cancelled
  category    String?  // electrical | plumbing | hvac | carpentry | civil | av | it
  raisedBy    String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([roomId])
}

// ════════════════════════════════════════════════════════════════
// AUDIT & NOTIFICATIONS
// ════════════════════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(cuid())
  propertyId  String?
  userId      String?
  userRole    String?
  user_email  String?
  action      String
  entityType  String?
  entityId    String?
  oldValue    String?  // JSON
  newValue    String?  // JSON
  ipAddress   String?
  occurredAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId, occurredAt])
  @@index([action])
}

model Notification {
  id         String   @id @default(cuid())
  propertyId String?
  userId     String?
  type       String   // info | success | warning | error | approval | alert
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId, isRead])
  @@index([userId, isRead])
}

model ShiftHandover {
  id          String   @id @default(cuid())
  propertyId  String
  fromUser    String
  toUser      String?
  shift       String   // morning | evening | night
  notes       String
  openIssues  String?
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model NightAuditLog {
  id            String   @id @default(cuid())
  propertyId    String
  businessDate  DateTime
  status        String   @default("running") // running | completed | failed
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  startedBy     String
  postingsCount Int      @default(0)
  revenuePosted Float    @default(0)
  noShowsCount  Int      @default(0)
  notes         String?

  @@index([propertyId, businessDate])
  @@index([propertyId, status])
}

// ════════════════════════════════════════════════════════════════
// HR MODULE — Attendance, Payroll, Events, Scorecards
// ════════════════════════════════════════════════════════════════

model Attendance {
  id            String   @id @default(cuid())
  propertyId    String
  userId        String
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  status        String   @default("present") // present | absent | half_day | late | on_leave | holiday | weekly_off
  overtimeHours Float    @default(0)
  workHours     Float    @default(0)
  notes         String?
  source        String   @default("manual") // manual | excel | biometric | system
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([propertyId, date])
  @@index([userId, date])
}

model PayrollRecord {
  id              String    @id @default(cuid())
  propertyId      String
  userId          String
  month           Int       // 1-12
  year            Int
  basicSalary     Float     @default(0)
  hra             Float     @default(0)
  da              Float     @default(0)
  conveyance      Float     @default(0)
  medical         Float     @default(0)
  specialAllow    Float     @default(0)
  overtime        Float     @default(0)
  bonus           Float     @default(0)
  grossEarnings   Float     @default(0)
  pf              Float     @default(0)
  esi             Float     @default(0)
  tax             Float     @default(0)
  pt              Float     @default(0) // Professional Tax
  loanDeduction   Float     @default(0)
  otherDeductions Float     @default(0)
  totalDeductions Float     @default(0)
  netPay          Float     @default(0)
  presentDays     Int       @default(0)
  absentDays      Int       @default(0)
  leaveDays       Int       @default(0)
  halfDays        Int       @default(0)
  status          String    @default("draft") // draft | processed | paid
  paidOn          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([propertyId, month, year])
  @@index([status])
}

model CompanyEvent {
  id          String    @id @default(cuid())
  propertyId  String
  title       String
  description String?
  type        String    @default("other") // festival | training | meeting | celebration | audit | inspection | other
  eventDate   DateTime
  endDate     DateTime?
  venue       String?
  organizerId String?
  status      String    @default("upcoming") // upcoming | ongoing | completed | cancelled
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  organizer User?    @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)

  @@index([propertyId, eventDate])
  @@index([status])
}

model Scorecard {
  id              String   @id @default(cuid())
  propertyId      String
  userId          String
  period          String   // "2024-01" monthly or "2024-Q1" quarterly
  attendance      Float    @default(0) // percentage
  punctuality     Float    @default(0) // 0-10
  taskCompletion  Float    @default(0) // percentage
  guestFeedback   Float    @default(0) // 0-10
  teamwork        Float    @default(0) // 0-10
  initiative      Float    @default(0) // 0-10
  grooming        Float    @default(0) // 0-10
  communication   Float    @default(0) // 0-10
  overallScore    Float    @default(0) // weighted average 0-100
  grade           String   @default("B") // A+ | A | B+ | B | C | D
  remarks         String?
  reviewedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([propertyId])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════
// SALES & MARKETING
// ════════════════════════════════════════════════════════════════

model Lead {
  id              String   @id @default(cuid())
  propertyId      String
  companyName     String
  contactName     String
  contactEmail    String?
  contactPhone    String?
  source          String   @default("direct") // direct | referral | website | linkedin | expo | cold_call | ota_partner
  status          String   @default("new") // new | contacted | qualified | proposal | negotiation | won | lost
  estimatedValue  Float    @default(0)
  probability     Int      @default(20) // 0-100
  assignedToId    String?
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  deals      Deal[]

  @@index([propertyId, status])
  @@index([assignedToId])
}

model Deal {
  id             String   @id @default(cuid())
  propertyId     String
  leadId         String
  title          String
  value          Float    @default(0)
  stage          String   @default("prospecting") // prospecting | qualification | proposal | negotiation | closed_won | closed_lost
  probability    Int      @default(20)
  closeDate      DateTime?
  assignedToId   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation("DealAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([propertyId, stage])
  @@index([leadId])
}

model Campaign {
  id             String   @id @default(cuid())
  propertyId     String
  name           String
  type           String   @default("social") // social | email | ppc | display | content | influencer | seo
  platform       String   @default("multi") // multi | instagram | facebook | linkedin | google | youtube | twitter
  status         String   @default("draft") // draft | active | paused | completed | cancelled
  budget         Float    @default(0)
  spent          Float    @default(0)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  leads          Int      @default(0)
  revenue        Float    @default(0)
  startDate      DateTime?
  endDate        DateTime?
  targetAudience String?
  objective      String?  // awareness | engagement | traffic | conversions | lead_gen | sales
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([platform])
}

model SocialAccount {
  id           String   @id @default(cuid())
  propertyId   String
  platform     String   // instagram | facebook | linkedin | youtube | twitter | tiktok | pinterest
  handle       String
  displayName  String?
  avatarUrl    String?
  followerCount Int     @default(0)
  followingCount Int    @default(0)
  postCount    Int      @default(0)
  engagementRate Float  @default(0)
  accessToken  String?
  refreshToken String?
  isActive     Boolean  @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, platform, handle])
  @@index([propertyId])
}

// ════════════════════════════════════════════════════════════════
// MODULE SYSTEM — Module ON/OFF per property
// ════════════════════════════════════════════════════════════════

model ModuleConfig {
  id          String   @id @default(cuid())
  propertyId  String
  moduleKey   String   // e.g. "hospital", "inventory", "finance"
  enabled     Boolean  @default(false)
  config      String   @default("{}") // JSON: module-specific config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, moduleKey])
  @@index([propertyId])
}

// ════════════════════════════════════════════════════════════════
// RBAC — Permissions & Role Templates
// ════════════════════════════════════════════════════════════════

model Permission {
  id          String   @id @default(cuid())
  moduleKey   String   // e.g. "reservations", "rooms"
  action      String   // e.g. "create", "read", "update", "delete", "approve"
  resource    String   // e.g. "reservation", "room", "folio"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([moduleKey, action, resource])
  @@index([moduleKey])
}

model RolePermission {
  id           String   @id @default(cuid())
  role         String   // e.g. "fom", "receptionist"
  permissionId String
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean  @default(true) // true = allow, false = deny (override)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════
// SESSION & AUTH — Enterprise session management
// ════════════════════════════════════════════════════════════════

model Session {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  deviceInfo  String?
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  lastActiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String?
  email       String?
  action      String   // login | logout | failed_login | token_refresh | force_logout
  ipAddress   String?
  userAgent   String?
  deviceInfo  String?
  success     Boolean  @default(true)
  failureReason String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════
// HOSPITAL MODULE — Patients, Doctors, Appointments
// ════════════════════════════════════════════════════════════════

model Patient {
  id              String   @id @default(cuid())
  propertyId      String
  patientId       String   @unique // auto-generated e.g. PAT-001
  firstName       String
  lastName        String
  age             Int?
  gender          String?
  phone           String?
  email           String?
  address         String?
  bloodGroup      String?
  allergies       String   @default("[]") // JSON array
  medicalHistory  String   @default("{}") // JSON
  emergencyContact String?
  insuranceProvider String?
  insurancePolicy String?
  status          String   @default("active") // active | discharged | deceased
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([propertyId])
  @@index([patientId])
}

model Doctor {
  id            String   @id @default(cuid())
  propertyId    String
  firstName     String
  lastName      String
  specialization String?
  qualification String?
  phone         String?
  email         String?
  department    String?
  consultationFee Float  @default(0)
  availableDays String   @default("[]") // JSON array: ["MON","TUE",...]
  availableFrom String?  // e.g. "09:00"
  availableTo   String?  // e.g. "17:00"
  status        String   @default("active") // active | on_leave | inactive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([propertyId])
  @@index([specialization])
}

model Appointment {
  id          String   @id @default(cuid())
  propertyId  String
  patientId   String
  doctorId    String
  appointmentDate DateTime
  timeSlot    String?  // e.g. "09:00-09:30"
  type        String   @default("opd") // opd | ipd | emergency | follow_up
  status      String   @default("scheduled") // scheduled | in_progress | completed | cancelled | no_show
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  patient  Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor   Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([propertyId, appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([patientId])
}

// ════════════════════════════════════════════════════════════════
// INVENTORY MODULE — Stock, Procurement, Vendors
// ════════════════════════════════════════════════════════════════

model StockItem {
  id             String   @id @default(cuid())
  propertyId     String
  name           String
  sku            String?
  category       String?  // food | beverage | linen | amenity | cleaning | stationary | engineering | medical
  unit           String   @default("pcs") // pcs | kg | liter | box | pack | set
  quantity       Float    @default(0)
  reorderLevel   Float    @default(0)
  maxStock       Float    @default(0)
  unitCost       Float    @default(0)
  sellingPrice   Float    @default(0)
  location       String?  // warehouse | kitchen | bar | store
  vendorId       String?
  expiryDate     DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, category])
  @@index([propertyId, name])
}

model Vendor {
  id            String   @id @default(cuid())
  propertyId    String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  panNumber     String?
  category      String?  // food | beverage | amenity | maintenance | general
  rating        Int      @default(5)
  paymentTerms  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, category])
  @@index([propertyId, name])
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  propertyId    String
  vendorId      String?
  poNumber      String   @unique
  status        String   @default("draft") // draft | submitted | approved | received | cancelled
  totalAmount   Float    @default(0)
  notes         String?
  requestedById String?
  approvedById  String?
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([vendorId])
}

// ════════════════════════════════════════════════════════════════
// FINANCE MODULE — Invoices, Expenses, GST
// ════════════════════════════════════════════════════════════════

model Invoice {
  id              String   @id @default(cuid())
  propertyId      String
  invoiceNumber   String   @unique
  invoiceType     String   @default("tax_invoice") // tax_invoice | proforma | credit_note | debit_note
  partyName       String
  partyGst        String?
  amount          Float    @default(0)
  cgst            Float    @default(0)
  sgst            Float    @default(0)
  igst            Float    @default(0)
  totalAmount     Float    @default(0)
  status          String   @default("draft") // draft | sent | paid | partial | overdue | cancelled
  dueDate         DateTime?
  paidAmount      Float    @default(0)
  notes           String?
  reservationId   String?
  folioId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([propertyId, invoiceType])
  @@index([dueDate])
}

model Expense {
  id            String   @id @default(cuid())
  propertyId    String
  category      String   // utilities | salary | supplies | maintenance | marketing | travel | food | miscellaneous
  description   String
  amount        Float
  paidTo        String?
  paymentMethod String   @default("cash") // cash | bank_transfer | upi | credit_card | cheque
  receiptUrl    String?
  expenseDate   DateTime
  approvedById  String?
  status        String   @default("pending") // pending | approved | rejected | paid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, category])
  @@index([propertyId, expenseDate])
  @@index([status])
}

model CashbookEntry {
  id            String   @id @default(cuid())
  propertyId    String
  entryType     String   // receipt | payment | transfer | adjustment
  account       String   // cash | bank | petty_cash
  amount        Float
  balance       Float    @default(0) // running balance
  description   String?
  referenceId   String?  // link to invoice/expense/payment
  referenceType String?  // invoice | expense | payment | folio
  entryDate     DateTime
  createdAt     DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, account, entryDate])
  @@index([propertyId, entryDate])
}

// ════════════════════════════════════════════════════════════════
// TASKS & DOCUMENTS
// ════════════════════════════════════════════════════════════════

model Task {
  id          String   @id @default(cuid())
  propertyId  String
  title       String
  description String?
  status      String   @default("todo") // todo | in_progress | done | cancelled
  priority    String   @default("medium") // urgent | high | medium | low
  assignedToId String?
  assignedById String?
  dueDate     DateTime?
  completedAt DateTime?
  moduleKey   String?  // which module created this task
  tags        String   @default("[]") // JSON array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy User?    @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([assignedToId])
  @@index([dueDate])
}

model Document {
  id           String   @id @default(cuid())
  propertyId   String
  name         String
  category     String   @default("general") // contract | invoice | report | policy | template | general
  fileType     String?  // pdf | docx | xlsx | jpg | png
  fileUrl      String?
  fileSize     Int      @default(0) // bytes
  uploadedById String?
  tags         String   @default("[]") // JSON
  isTemplate   Boolean  @default(false)
  version      Int      @default(1)
  status       String   @default("active") // active | archived | deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([propertyId, category])
  @@index([propertyId, name])
}

// ════════════════════════════════════════════════════════════════
// INTEGRATION CONFIG
// ════════════════════════════════════════════════════════════════

model IntegrationConfig {
  id           String   @id @default(cuid())
  propertyId   String
  provider     String   // booking_com | agoda | expedia | razorpay | stripe | whatsapp | gmail | tally | zoho
  category     String   // ota | payment | communication | accounting
  isActive     Boolean  @default(false)
  credentials  String   @default("{}") // JSON: encrypted credentials
  settings     String   @default("{}") // JSON: integration settings
  lastSyncAt   DateTime?
  syncStatus   String   @default("never") // never | syncing | success | error
  syncError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, provider])
  @@index([propertyId, category])
}
