// ARIA HMS — Hospitality Management System
// Prisma schema (SQLite). Note: SQLite has no native ENUM / array / JSONB,
// so enums are stored as String with app-level validation, and arrays/objects
// are stored as JSON strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════
// PROPERTY & ORG
// ════════════════════════════════════════════════════════════════

model Property {
  id            String   @id @default(cuid())
  name          String
  code          String
  city          String
  state         String?
  country       String
  timezone      String   @default("Asia/Calcutta")
  currency      String   @default("INR")
  starRating    Int      @default(5)
  totalRooms    Int      @default(0)
  checkInTime   String   @default("14:00")
  checkOutTime  String   @default("12:00")
  gstNumber     String?
  taxId         String?
  logoUrl       String?
  status        String   @default("active") // active | suspended
  businessDate  DateTime @default(now())    // current business date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roomCategories    RoomCategory[]
  rooms             Room[]
  reservations      Reservation[]
  housekeepingTasks HousekeepingTask[]
  outlets           Outlet[]
  ratePlans         RatePlan[]
  auditLogs         AuditLog[]
  users             User[]
  departments       Department[]
  shiftHandovers    ShiftHandover[]
}

model Department {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  code       String // FO | HK | FB | ENG | HR | FIN | SEC
  headUserId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  users    User[]

  @@index([propertyId])
}

model User {
  id            String   @id @default(cuid())
  propertyId    String?
  email         String   @unique
  firstName     String
  lastName      String
  role          String   // owner | gm | fom | hk_mgr | fb_mgr | rev_mgr | fin_mgr | eng_mgr | hr_mgr | receptionist | hk_attendant | waiter | technician
  roleLevel     Int      @default(4) // 1 owner, 2 gm, 3 manager, 4 staff
  departmentId  String?
  employeeCode  String?
  phone         String?
  isActive      Boolean  @default(true)
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property    Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  hkTasks     HousekeepingTask[] @relation("HkTaskAssignee")
  hkInspected HousekeepingTask[] @relation("HkTaskInspector")
  posOrders   PosOrder[]   @relation("PosOrderWaiter")
  auditLogs   AuditLog[]

  @@index([propertyId])
}

// ════════════════════════════════════════════════════════════════
// ROOMS & RATES
// ════════════════════════════════════════════════════════════════

model RoomCategory {
  id                  String   @id @default(cuid())
  propertyId          String
  name                String
  code                String
  description         String?
  maxAdults           Int      @default(2)
  maxChildren         Int      @default(1)
  baseRate            Float
  amenities           String   @default("[]") // JSON array
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms        Room[]
  ratePlans    RatePlan[]   @relation("RatePlanCategories")
  reservations Reservation[]

  @@index([propertyId])
}

model Room {
  id            String   @id @default(cuid())
  propertyId    String
  categoryId    String
  roomNumber    String
  floor         Int
  wing          String?
  currentStatus String   @default("vacant_clean")
  // vacant_clean | vacant_dirty | occupied_clean | occupied_dirty | out_of_order | out_of_service
  isSmoking     Boolean  @default(false)
  isAccessible  Boolean  @default(false)
  notes         String?
  blockedReason String?
  blockedUntil  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category         RoomCategory      @relation(fields: [categoryId], references: [id])
  statusLogs       RoomStatusLog[]
  hkTasks          HousekeepingTask[]
  reservationRooms Reservation[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId, currentStatus])
}

model RoomStatusLog {
  id         String   @id @default(cuid())
  roomId     String
  oldStatus  String?
  newStatus  String
  changedBy  String?
  reason     String?
  changedAt  DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model RatePlan {
  id                 String   @id @default(cuid())
  propertyId         String
  name               String
  code               String
  description        String?
  mealPlan           String   @default("ep") // ep | cp | map | ap
  isRefundable       Boolean  @default(true)
  advancePurchaseDays Int     @default(0)
  minStayNights      Int      @default(1)
  maxStayNights      Int      @default(30)
  validFrom          DateTime
  validTo            DateTime
  markupPercent      Float    @default(0) // over base rate
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  categories  RoomCategory[] @relation("RatePlanCategories")
  reservations Reservation[]

  @@index([propertyId])
}

// ════════════════════════════════════════════════════════════════
// GUESTS & RESERVATIONS
// ════════════════════════════════════════════════════════════════

model Guest {
  id              String   @id @default(cuid())
  title           String   @default("Mr")
  firstName       String
  lastName        String
  email           String?
  phone           String?
  nationality     String   @default("IN")
  idType          String?  // passport | aadhaar | driving_license | voter
  idNumber        String?
  dateOfBirth     DateTime?
  address         String?
  city            String?
  state           String?
  country         String   @default("IN")
  loyaltyTier     String   @default("silver") // none | silver | gold | platinum
  loyaltyPoints   Int      @default(0)
  preferences     String   @default("{}") // JSON
  vipStatus       Boolean  @default(false)
  doNotDisturb    Boolean  @default(false)
  totalStays      Int      @default(0)
  totalRevenue    Float    @default(0)
  blacklisted     Boolean  @default(false)
  blacklistReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  primaryReservations Reservation[] @relation("PrimaryGuestReservations")

  @@index([email])
  @@index([phone])
}

model Company {
  id            String   @id @default(cuid())
  name          String
  gstNumber     String?
  address       String?
  creditLimit   Float    @default(0)
  paymentTerms  String?
  contactName   String?
  contactEmail  String?
  negotiatedRate Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservations Reservation[]
}

model Reservation {
  id              String   @id @default(cuid())
  propertyId      String
  confirmationNumber String @unique
  bookingSource   String   @default("direct") // direct | booking_com | expedia | airbnb | makemytrip | goibibo | agoda | corporate | walk_in | phone
  status          String   @default("confirmed") // confirmed | tentative | waitlisted | checked_in | checked_out | cancelled | no_show
  primaryGuestId  String
  companyId       String?
  categoryId      String
  roomId          String?
  ratePlanId      String?
  ratePerNight    Float
  totalNights     Int
  checkInDate     DateTime
  checkOutDate    DateTime
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  adults          Int      @default(2)
  children        Int      @default(0)
  infants         Int      @default(0)
  specialRequests String?
  internalNotes   String?
  otaCommissionPercent Float @default(0)
  otaCommissionAmount   Float @default(0)
  netRevenue      Float    @default(0)
  depositAmount   Float    @default(0)
  cancellationReason String?
  cancelledAt     DateTime?
  cancelledBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  primaryGuest Guest        @relation("PrimaryGuestReservations", fields: [primaryGuestId], references: [id])
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  category     RoomCategory @relation(fields: [categoryId], references: [id])
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  ratePlan     RatePlan?    @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  folios       Folio[]

  @@index([propertyId, status])
  @@index([propertyId, checkInDate])
  @@index([primaryGuestId])
}

// ════════════════════════════════════════════════════════════════
// FOLIO & BILLING
// ════════════════════════════════════════════════════════════════

model Folio {
  id           String   @id @default(cuid())
  reservationId String
  folioNumber  String   @unique
  folioType    String   @default("room") // room | extra | advance | city_ledger
  status       String   @default("open") // open | closed | transferred
  subtotal     Float    @default(0)
  taxAmount    Float    @default(0)
  totalAmount  Float    @default(0)
  paidAmount   Float    @default(0)
  balance      Float    @default(0)
  createdAt    DateTime @default(now())
  closedAt     DateTime?
  closedBy     String?

  reservation Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  lines       FolioLine[]
  payments    Payment[]

  @@index([reservationId])
}

model FolioLine {
  id              String   @id @default(cuid())
  folioId         String
  transactionType String   @default("charge") // charge | payment | adjustment | void
  description     String
  amount          Float    @default(0)
  taxCode         String?
  taxAmount       Float    @default(0)
  departmentCode  String?  // ROOM | FB | MINIBAR | LAUNDRY | SPA | MISC
  outletCode      String?
  postedAt        DateTime @default(now())
  postedBy        String?
  referenceType   String?  // pos_order | minibar | room_rate | manual
  referenceId     String?
  isVoided        Boolean  @default(false)
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
}

model Payment {
  id            String   @id @default(cuid())
  folioId       String
  amount        Float
  paymentMethod String   // cash | credit_card | debit_card | upi | bank_transfer | city_ledger
  paymentReference String?
  cardLast4     String?
  cardType      String?
  status        String   @default("completed") // pending | completed | failed | refunded
  processedAt   DateTime @default(now())
  processedBy   String?

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
}

// ════════════════════════════════════════════════════════════════
// HOUSEKEEPING
// ════════════════════════════════════════════════════════════════

model HousekeepingTask {
  id            String   @id @default(cuid())
  propertyId    String
  roomId        String
  taskType      String   @default("checkout_cleaning") // checkout_cleaning | stayover | turndown | deep_clean | inspection | maintenance_prep
  assignedToId  String?
  priority      String   @default("normal") // urgent | high | normal | low
  status        String   @default("pending") // pending | in_progress | completed | inspected | rejected
  scheduledFor  DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  inspectedById String?
  inspectedAt   DateTime?
  rejectionReason String?
  checklist     String   @default("[]") // JSON array of {item, done}
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee    User?    @relation("HkTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  inspector   User?    @relation("HkTaskInspector", fields: [inspectedById], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([assignedToId])
}

model LostFound {
  id              String   @id @default(cuid())
  propertyId      String
  itemDescription String
  itemCategory    String?
  foundLocation   String?
  foundDate       DateTime @default(now())
  foundBy         String?
  storageLocation String?
  status          String   @default("in_custody") // in_custody | claimed | disposed | donated
  claimedBy       String?
  claimedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId, status])
}

// ════════════════════════════════════════════════════════════════
// F&B / POS
// ════════════════════════════════════════════════════════════════

model Outlet {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  code       String
  type       String   @default("restaurant") // restaurant | bar | cafe | room_service | banquet | pool_bar
  isActive   Boolean  @default(true)
  tableCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tables     RestaurantTable[]
  menuCategories MenuCategory[]
  orders     PosOrder[]

  @@index([propertyId])
}

model RestaurantTable {
  id         String   @id @default(cuid())
  outletId   String
  tableNumber String
  capacity   Int      @default(4)
  status     String   @default("available") // available | occupied | reserved | cleaning
  section    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders PosOrder[]

  @@unique([outletId, tableNumber])
}

model MenuCategory {
  id         String   @id @default(cuid())
  outletId   String
  name       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  mealPeriod String   @default("[]") // JSON array
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([outletId])
}

model MenuItem {
  id            String   @id @default(cuid())
  categoryId    String
  name          String
  description   String?
  price         Float
  itemType      String   @default("food") // food | beverage | package
  dietType      String   @default("veg") // veg | non_veg | vegan | contains_egg | contains_alcohol
  allergens     String   @default("[]")
  preparationTimeMinutes Int @default(15)
  isAvailable   Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  photoUrl      String?
  recipeCost    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category   MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderLines PosOrderLine[]

  @@index([categoryId])
}

model PosOrder {
  id            String   @id @default(cuid())
  outletId      String
  tableId       String?
  reservationId String?
  orderType     String   @default("dine_in") // dine_in | room_service | takeaway | delivery | banquet
  status        String   @default("draft") // draft | sent_to_kitchen | in_preparation | ready | served | billed | paid | void
  waiterId      String?
  subtotal      Float    @default(0)
  discountAmount Float   @default(0)
  taxAmount     Float    @default(0)
  totalAmount   Float    @default(0)
  guestsCount   Int      @default(1)
  notes         String?
  kotNumber     Int?
  createdAt     DateTime @default(now())
  billedAt      DateTime?
  paidAt        DateTime?

  outlet Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table  RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiter User?            @relation("PosOrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  lines  PosOrderLine[]

  @@index([outletId, status])
}

model PosOrderLine {
  id                String   @id @default(cuid())
  orderId           String
  itemId            String
  quantity          Int      @default(1)
  unitPrice         Float
  specialInstructions String?
  status            String   @default("pending") // pending | in_progress | ready | served | void
  voidReason        String?
  createdAt         DateTime @default(now())

  order PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  MenuItem  @relation(fields: [itemId], references: [id])

  @@index([orderId])
}

// ════════════════════════════════════════════════════════════════
// MAINTENANCE
// ════════════════════════════════════════════════════════════════

model MaintenanceTicket {
  id          String   @id @default(cuid())
  propertyId  String
  roomId      String?
  title       String
  description String?
  priority    String   @default("normal") // urgent | high | normal | low
  status      String   @default("open") // open | in_progress | completed | cancelled
  category    String?  // electrical | plumbing | hvac | carpentry | civil | av | it
  raisedBy    String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([roomId])
}

// ════════════════════════════════════════════════════════════════
// AUDIT & NOTIFICATIONS
// ════════════════════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(cuid())
  propertyId  String?
  userId      String?
  userRole    String?
  user_email  String?
  action      String
  entityType  String?
  entityId    String?
  oldValue    String?  // JSON
  newValue    String?  // JSON
  ipAddress   String?
  occurredAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId, occurredAt])
  @@index([action])
}

model Notification {
  id         String   @id @default(cuid())
  propertyId String?
  userId     String?
  type       String   // info | success | warning | error | approval | alert
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId, isRead])
  @@index([userId, isRead])
}

model ShiftHandover {
  id          String   @id @default(cuid())
  propertyId  String
  fromUser    String
  toUser      String?
  shift       String   // morning | evening | night
  notes       String
  openIssues  String?
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model NightAuditLog {
  id            String   @id @default(cuid())
  propertyId    String
  businessDate  DateTime
  status        String   @default("running") // running | completed | failed
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  startedBy     String
  postingsCount Int      @default(0)
  revenuePosted Float    @default(0)
  noShowsCount  Int      @default(0)
  notes         String?

  @@index([propertyId, businessDate])
  @@index([propertyId, status])
}
